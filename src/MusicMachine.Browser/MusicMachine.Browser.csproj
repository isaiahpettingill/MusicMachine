<Project Sdk="Microsoft.NET.Sdk.WebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0-browser</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- WebAssembly uses the managed runtime; NativeAOT is the desktop release target. -->
    <RunAOTCompilation>false</RunAOTCompilation>
    <WasmBuildNative>true</WasmBuildNative>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Browser" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.WebAssembly" />
    <PackageReference Include="HarfBuzzSharp" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.WebAssembly" />
    <ProjectReference Include="../MusicMachine.App/MusicMachine.App.csproj" />
  </ItemGroup>
  <ItemGroup>
    <StaticWebAssetFingerprintPattern Include="JS" Pattern="main.js" Expression="#[.{fingerprint}]!" />
  </ItemGroup>
  <!-- Link one graphics archive pair matching the .NET 10 Emscripten toolchain. -->
  <Target Name="SelectGraphicsArchives" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <NativeFileReference Remove="@(NativeFileReference)"
        Condition="$([System.String]::Copy('%(NativeFileReference.Identity)').Contains('libSkiaSharp')) or $([System.String]::Copy('%(NativeFileReference.Identity)').Contains('libHarfBuzzSharp'))" />
      <NativeFileReference Include="$(SkiaSharpStaticLibraryPath)/3.1.56/st,simd/*.a" />
      <NativeFileReference Include="$(HarfBuzzSharpStaticLibraryPath)/3.1.56/st,simd/*.a" />
    </ItemGroup>
    <Error Condition="!Exists('$(SkiaSharpStaticLibraryPath)/3.1.56/st,simd/libSkiaSharp.a')" Text="The Skia WebAssembly archive was not found. Restore browser package dependencies." />
  </Target>
  <!-- Optional converter is generated explicitly. Verify its accompanying
       source/relink bundle and notices rather than silently shipping old cores. -->
  <Target Name="VerifyAudioConverterDistribution" BeforeTargets="PrepareForPublish"
          Condition="Exists('$(MSBuildProjectDirectory)/wwwroot/vendor/ffmpeg')">
    <Exec WorkingDirectory="$(MSBuildProjectDirectory)" Command="node tools/verify-converter-distribution.mjs" />
  </Target>
</Project>
